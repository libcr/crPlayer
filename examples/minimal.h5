<!-- Minimal crPlayer integration: no external resources. -->
<style>
html,body{background:transparent!important;color:white!important;font:16px system-ui}
#panel{position:fixed;bottom:20px;left:20px;right:20px;padding:14px;border-radius:12px;background:#101827dc;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
button{padding:10px 16px;border:0;border-radius:8px;background:#67e8f9;color:#082f49;font:inherit;cursor:pointer}output{font-variant-numeric:tabular-nums}
</style>
<div id="panel"><button id="toggle">Play</button><button id="restart">Replay</button><button id="full">Fullscreen</button><output id="time">00:00</output><span id="error" role="alert"></span></div>
<script>
(() => {
 const translations={"en-US":{"play":"Play","pause":"Pause","replay":"Replay","mute":"Mute","unmute":"Unmute","fullscreen":"Fullscreen","exit":"Exit fullscreen","seek":"Seek","volume":"Volume","speed":"Speed","loading":"Loading…","buffering":"Buffering…","ready":"Ready","back":"Back 10 seconds","forward":"Forward 10 seconds","preview":"Open this file with crPlayer to control a video."},"zh-CN":{"play":"播放","pause":"暂停","replay":"重播","mute":"静音","unmute":"取消静音","fullscreen":"全屏","exit":"退出全屏","seek":"进度","volume":"音量","speed":"倍速","loading":"正在加载…","buffering":"正在缓冲…","ready":"就绪","back":"后退 10 秒","forward":"前进 10 秒","preview":"请使用 crPlayer 打开此文件以控制视频。"},"zh-HK":{"play":"播放","pause":"暫停","replay":"重播","mute":"靜音","unmute":"取消靜音","fullscreen":"全螢幕","exit":"退出全螢幕","seek":"進度","volume":"音量","speed":"播放速度","loading":"載入中…","buffering":"緩衝中…","ready":"就緒","back":"後退 10 秒","forward":"前進 10 秒","preview":"請使用 crPlayer 開啟此檔案以控制影片。"},"zh-TW":{"play":"播放","pause":"暫停","replay":"重播","mute":"靜音","unmute":"取消靜音","fullscreen":"全螢幕","exit":"結束全螢幕","seek":"進度","volume":"音量","speed":"播放速度","loading":"載入中…","buffering":"緩衝中…","ready":"就緒","back":"倒退 10 秒","forward":"快轉 10 秒","preview":"請使用 crPlayer 開啟此檔案以控制影片。"},"ar":{"play":"تشغيل","pause":"إيقاف مؤقت","replay":"إعادة التشغيل","mute":"كتم الصوت","unmute":"إلغاء الكتم","fullscreen":"ملء الشاشة","exit":"إنهاء ملء الشاشة","seek":"الموضع","volume":"مستوى الصوت","speed":"السرعة","loading":"جارٍ التحميل…","buffering":"جارٍ التخزين المؤقت…","ready":"جاهز","back":"رجوع 10 ثوانٍ","forward":"تقديم 10 ثوانٍ","preview":"افتح هذا الملف باستخدام crPlayer للتحكم بالفيديو."},"fr":{"play":"Lire","pause":"Pause","replay":"Relire","mute":"Couper le son","unmute":"Rétablir le son","fullscreen":"Plein écran","exit":"Quitter le plein écran","seek":"Position","volume":"Volume","speed":"Vitesse","loading":"Chargement…","buffering":"Mise en mémoire tampon…","ready":"Prêt","back":"Reculer de 10 secondes","forward":"Avancer de 10 secondes","preview":"Ouvrez ce fichier avec crPlayer pour contrôler une vidéo."},"ru":{"play":"Воспроизвести","pause":"Пауза","replay":"Повторить","mute":"Без звука","unmute":"Включить звук","fullscreen":"Полный экран","exit":"Выйти из полного экрана","seek":"Позиция","volume":"Громкость","speed":"Скорость","loading":"Загрузка…","buffering":"Буферизация…","ready":"Готово","back":"Назад на 10 секунд","forward":"Вперёд на 10 секунд","preview":"Откройте этот файл в crPlayer для управления видео."},"es":{"play":"Reproducir","pause":"Pausa","replay":"Repetir","mute":"Silenciar","unmute":"Activar sonido","fullscreen":"Pantalla completa","exit":"Salir de pantalla completa","seek":"Posición","volume":"Volumen","speed":"Velocidad","loading":"Cargando…","buffering":"Almacenando en búfer…","ready":"Listo","back":"Retroceder 10 segundos","forward":"Avanzar 10 segundos","preview":"Abre este archivo con crPlayer para controlar un vídeo."},"pt-BR":{"play":"Reproduzir","pause":"Pausar","replay":"Repetir","mute":"Silenciar","unmute":"Ativar som","fullscreen":"Tela cheia","exit":"Sair da tela cheia","seek":"Posição","volume":"Volume","speed":"Velocidade","loading":"Carregando…","buffering":"Armazenando em buffer…","ready":"Pronto","back":"Voltar 10 segundos","forward":"Avançar 10 segundos","preview":"Abra este arquivo com o crPlayer para controlar um vídeo."},"pt-PT":{"play":"Reproduzir","pause":"Pausar","replay":"Repetir","mute":"Silenciar","unmute":"Ativar som","fullscreen":"Ecrã inteiro","exit":"Sair do ecrã inteiro","seek":"Posição","volume":"Volume","speed":"Velocidade","loading":"A carregar…","buffering":"A colocar em memória intermédia…","ready":"Pronto","back":"Recuar 10 segundos","forward":"Avançar 10 segundos","preview":"Abra este ficheiro com o crPlayer para controlar um vídeo."},"fr-CA":{"play":"Lire","pause":"Pause","replay":"Relire","mute":"Couper le son","unmute":"Rétablir le son","fullscreen":"Plein écran","exit":"Quitter le plein écran","seek":"Position","volume":"Volume","speed":"Vitesse","loading":"Chargement…","buffering":"Mise en mémoire tampon…","ready":"Prêt","back":"Reculer de 10 secondes","forward":"Avancer de 10 secondes","preview":"Ouvrez ce fichier avec crPlayer pour contrôler une vidéo."},"es-419":{"play":"Reproducir","pause":"Pausa","replay":"Repetir","mute":"Silenciar","unmute":"Activar sonido","fullscreen":"Pantalla completa","exit":"Salir de pantalla completa","seek":"Posición","volume":"Volumen","speed":"Velocidad","loading":"Cargando…","buffering":"Almacenando en búfer…","ready":"Listo","back":"Retroceder 10 segundos","forward":"Avanzar 10 segundos","preview":"Abre este archivo con crPlayer para controlar un vídeo."}}, player=window.crPlayer, $=id=>document.getElementById(id);
 if (!player) { $('error').textContent=translations['en-US'].preview;document.querySelectorAll('button').forEach(b=>b.disabled=true);return; }
 $('toggle').onclick=()=>player.toggle();
 $('restart').onclick=()=>{player.seek(0);player.play();};
 $('full').onclick=()=>player.setFullscreen(!player.state.fullscreen);
 const render=state=>{
  const t=translations[state.locale]||translations['en-US'];
  document.documentElement.lang=state.locale||'en-US';document.documentElement.dir=state.locale==='ar'?'rtl':'ltr';
  $('toggle').textContent=state.paused?t.play:t.pause;$('restart').textContent=t.replay;$('full').textContent=state.fullscreen?t.exit:t.fullscreen;
  $('toggle').disabled=$('restart').disabled=!state.ready;
  $('time').textContent=(Number(state.currentTime)||0).toFixed(1)+' / '+(Number(state.duration)||0).toFixed(1)+' s';
  $('error').textContent=state.error||'';
 };
 player.addEventListener('statechange',e=>render(e.detail));render(player.state);
})();
</script>
